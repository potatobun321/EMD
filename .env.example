# JAI Conclave 2026 (EMD) Environment Configuration Template
# Copy this file to .env and fill in your official Google Workspace values.

# Google Apps Script Web App Deployment URL
# Format: https://script.google.com/macros/s/<SCRIPT_ID>/exec
GAS_WEB_APP_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec"

# Google Apps Script Script ID (from Project Settings)
GAS_SCRIPT_ID="YOUR_SCRIPT_ID_HERE"

# Google Drive Folder IDs (from Column B of 00_Configuration)
QR_VAULT_FOLDER_ID="1a2b3c4d5e6f7g8h9i..."
ID_CARDS_FOLDER_ID="1a2b3c4d5e6f7g8h9i..."
CSV_IMPORT_FOLDER_ID="1a2b3c4d5e6f7g8h9i..."
CSV_ARCHIVE_FOLDER_ID="1a2b3c4d5e6f7g8h9i..."

# PWA Version String
APP_VERSION="v1.7.0"
